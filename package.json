{
  "name": "openlaser",
  "private": true,
  "version": "0.1.0",
  "description": "Laser engraver and cutter control in your browser. Free, open source, works offline.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "GOLDEN_UPDATE=1 vitest run tests/golden",
    "e2e": "playwright test",
    "icons": "node scripts/render-icons.mjs",
    "fonts:update": "node scripts/update-google-fonts.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@lucide/svelte": "^1.59.0",
    "bits-ui": "^2.19.5",
    "clipper2-ts": "2.0.1-18",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "nanoid": "^5.1.6",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.10.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.13.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
